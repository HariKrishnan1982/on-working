# Gateway Security
VFD_API_KEY=vfd-dev-secret-key-12345

# Blockchain & Fabric Bridge
VFD_ENFORCE_MODEL_REGISTRY=true
VFD_FABRIC_BRIDGE_URL=http://127.0.0.1:8081
VFD_FABRIC_BRIDGE_API_KEY=your-secure-bridge-api-key-here
VFD_VFD_HMAC_SECRET=your-offchain-hmac-salt-secret-here
VFD_MODEL_REGISTRY_CACHE_TTL_S=300

# Database
VFD_DATABASE_URL=postgresql://vfd:changeme@127.0.0.1:5432/voice_fraud
POSTGRES_PASSWORD=changeme

# Server
VFD_HOST=127.0.0.1
VFD_PORT=8000
VFD_LOG_LEVEL=INFO

# Telephony ingress (placeholders only — never commit real secrets)
VFD_TELEPHONY_PROVIDER=
VFD_TELEPHONY_API_KEY=
VFD_TELEPHONY_API_SECRET=
VFD_TELEPHONY_WEBHOOK_SECRET=
VFD_TELEPHONY_SIP_DOMAIN=
VFD_TELEPHONY_PUBLIC_BASE_URL=
VFD_TELEPHONY_LOCAL_RTP_ENABLED=true
VFD_TELEPHONY_LOCAL_RTP_HOST=127.0.0.1
VFD_TELEPHONY_LOCAL_RTP_PORT=10000
VFD_TELEPHONY_AUTO_ACCEPT_LOCAL=true
VFD_TELEPHONY_RATE_LIMIT_PER_MIN=60
VFD_TELEPHONY_EVENT_LOG_CAP=200
VFD_TELEPHONY_ACTION_MODE=detect-only

# Asterisk / ARI (placeholders only — never commit real secrets).
# ARI password + SIP extension passwords are generated on the Asterisk host by
# scripts/setup-asterisk-wsl2.sh and kept in your private .env only.
VFD_ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
VFD_ASTERISK_ARI_USER=voiceshield
VFD_ASTERISK_ARI_PASSWORD=
VFD_ASTERISK_ARI_APP=voiceshield
VFD_ASTERISK_ARI_TIMEOUT_S=5.0
# SIP extension secrets live on the Asterisk host only (asterisk/*-secrets.conf).
# SIP_100_PASSWORD=
# SIP_101_PASSWORD=
