node_modules/
dist/
build/
.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Python caches and environments
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/

# Ephemeral runtime audio storage (preserve directory via .gitkeep)
storage/uploads/*
!storage/uploads/.gitkeep
storage/preprocessed/*
!storage/preprocessed/.gitkeep
storage/transcripts/*
!storage/transcripts/.gitkeep
storage/profile_audio/*
!storage/profile_audio/.gitkeep

# Blockchain crypto material must never be committed (required by
# tests/test_secret_scan.py via scripts/secret_scan.py).
*.pem
*.key
wallet/
keystore/
